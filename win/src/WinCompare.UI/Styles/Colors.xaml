<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark Theme Resources -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DiffAddedBgBrush" Color="#2522C55E" />
            <SolidColorBrush x:Key="DiffAddedFgBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="DiffDeletedBgBrush" Color="#25EF4444" />
            <SolidColorBrush x:Key="DiffDeletedFgBrush" Color="#F87171" />
            <SolidColorBrush x:Key="DiffModifiedBgBrush" Color="#25EAB308" />
            <SolidColorBrush x:Key="DiffModifiedFgBrush" Color="#FACC15" />
            <SolidColorBrush x:Key="DiffPhantomBgBrush" Color="#15888888" />

            <SolidColorBrush x:Key="CardAcrylicBackground" Color="#E51E1E2E" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AICardTextBrush" Color="#DDD6FE" />

            <!-- ToggleSwitch High Contrast in Dark Mode -->
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#64748B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#94A3B8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1E293B" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#334155" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#475569" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#F1F5F9" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#3B82F6" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#60A5FA" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#93C5FD" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#3B82F6" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#60A5FA" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#93C5FD" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#F1F5F9" />
            <!-- Dividers & Surface -->
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#334155" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#EE1E1E2E" />
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#33FFFFFF" />
        </ResourceDictionary>

        <!-- Light Theme Resources -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DiffAddedBgBrush" Color="#2222C55E" />
            <SolidColorBrush x:Key="DiffAddedFgBrush" Color="#15803D" />
            <SolidColorBrush x:Key="DiffDeletedBgBrush" Color="#22EF4444" />
            <SolidColorBrush x:Key="DiffDeletedFgBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="DiffModifiedBgBrush" Color="#22EAB308" />
            <SolidColorBrush x:Key="DiffModifiedFgBrush" Color="#B45309" />
            <SolidColorBrush x:Key="DiffPhantomBgBrush" Color="#10888888" />

            <SolidColorBrush x:Key="CardAcrylicBackground" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#22000000" />
            <SolidColorBrush x:Key="AICardTextBrush" Color="#6D28D9" />

            <!-- Dividers & Surface -->
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#1F000000" />

            <!-- ToggleSwitch High Visibility Resources for Light Theme -->
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#94A3B8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#475569" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#334155" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#F8FAFC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#64748B" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#334155" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#1E293B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2563EB" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1E40AF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2563EB" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1E40AF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#F1F5F9" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Common Accent Brushes -->
    <SolidColorBrush x:Key="AIAccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AIAccentHoverBrush" Color="#A78BFA" />

</ResourceDictionary>
