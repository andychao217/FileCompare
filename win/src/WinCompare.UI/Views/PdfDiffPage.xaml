<Page
    x:Class="WinCompare.UI.Views.PdfDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Double Panes -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- View Mode Selector (Matching Mac SideBySide / Overlay) -->
                    <StackPanel Orientation="Horizontal" Spacing="2" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="2">
                        <Button x:Name="SideBySideModeBtn" Click="OnSideBySideModeClicked" Padding="8,4" Height="28" CornerRadius="4" BorderThickness="0" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock x:Name="SideBySideText" Text="左右并排" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OverlayModeBtn" Click="OnOverlayModeClicked" Padding="8,4" Height="28" CornerRadius="4" BorderThickness="0" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE790;" FontSize="11" />
                                <TextBlock x:Name="OverlayText" Text="重叠比对" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <AppBarSeparator />

                    <!-- Page Navigation -->
                    <Button x:Name="PrevPageBtn" Click="OnPrevPageClicked" Width="30" Height="28" Padding="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="PageIndicatorText" Text="1 / 1" VerticalAlignment="Center" FontSize="11.5" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="54" TextAlignment="Center" />
                    <Button x:Name="NextPageBtn" Click="OnNextPageClicked" Width="30" Height="28" Padding="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>

                    <AppBarSeparator />

                    <!-- Diff Navigation -->
                    <Button x:Name="PrevDiffBtn" Click="OnPrevDiffClicked" Width="30" Height="28" Padding="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE70E;" FontSize="11" />
                    </Button>
                    <Button x:Name="NextDiffBtn" Click="OnNextDiffClicked" Width="30" Height="28" Padding="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE70D;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="DiffCountText" Text="两份文档完全一致" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" />

                    <AppBarSeparator />

                    <!-- Zoom Controls -->
                    <Button x:Name="ZoomOutBtn" Click="OnZoomOutClicked" Width="30" Height="28" Padding="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE71F;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" FontSize="11.5" FontFamily="Consolas" Margin="2,0" MinWidth="44" TextAlignment="Center" />
                    <Button x:Name="ZoomInBtn" Click="OnZoomInClicked" Width="30" Height="28" Padding="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE71E;" FontSize="11" />
                    </Button>
                </StackPanel>

                <!-- Right Controls: Mask, Sync Scroll, Ignore Whitespace, Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowMaskCheck" IsChecked="True" FontSize="11.5"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              MinHeight="28" Padding="6,0,0,0" Margin="0" Click="OnOptionChanged">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="11" VerticalAlignment="Center" Margin="0" />
                            <TextBlock x:Name="ShowMaskText" Text="高亮差异遮罩" VerticalAlignment="Center" Margin="0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="SyncScrollCheck" IsChecked="True" FontSize="11.5"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              MinHeight="28" Padding="6,0,0,0" Margin="0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8AB;" FontSize="11" VerticalAlignment="Center" Margin="0" />
                            <TextBlock x:Name="SyncScrollText" Text="同步滚动" VerticalAlignment="Center" Margin="0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="IgnoreWhitespaceCheck" IsChecked="False" FontSize="11.5"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              MinHeight="28" Padding="6,0,0,0" Margin="0" Click="OnOptionChanged">
                        <TextBlock x:Name="IgnoreWhitespaceText" Text="忽略空白字符" VerticalAlignment="Center" Margin="0" />
                    </CheckBox>

                    <AppBarSeparator Margin="2,0" />

                    <Button x:Name="ExportReportBtn" Click="OnExportReportClicked" Padding="8,4" Height="28" CornerRadius="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDE1;" FontSize="11" VerticalAlignment="Center" Margin="0" />
                            <TextBlock x:Name="ExportReportText" Text="导出差异报告" FontSize="11.5" VerticalAlignment="Center" Margin="0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Work Area: Left & Right Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left PDF Pane -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  AllowDrop="True" DragOver="OnPaneDragOver" Drop="OnLeftPaneDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" Background="{ThemeResource WelcomeTextDiffBgBrush}" Margin="0,0,8,0">
                            <FontIcon Glyph="&#xEA90;" FontSize="12" Foreground="{ThemeResource WelcomeTextDiffFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="LeftHeaderTitle" Grid.Column="1" Text="左侧原文档 (.pdf)" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="OnChooseLeftFileClicked" Width="28" Height="24" Padding="0" CornerRadius="4" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty State Drop Zone (Matching Mac Empty Drop Zone) -->
                <Grid x:Name="LeftEmptyPanel" Grid.Row="1" Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource WelcomePdfDiffBgBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEA90;" FontSize="30" Foreground="{ThemeResource WelcomePdfDiffFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="LeftEmptyPromptText" Text="拖拽 PDF 文件到此处，或点击下方按钮选择" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Click="OnChooseLeftFileClicked" HorizontalAlignment="Center" Padding="16,8" CornerRadius="8" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="13" />
                                <TextBlock x:Name="LeftSelectBtnText" Text="选择左侧原文档" FontWeight="Medium" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- High-Fidelity Paper Viewport -->
                <ScrollViewer x:Name="LeftScrollViewer" Grid.Row="1" Padding="20"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ViewChanged="OnLeftScrollViewChanged" Visibility="Collapsed">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,24">
                        <Border x:Name="LeftPaperCard"
                                Background="White"
                                CornerRadius="4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Grid>
                                <Image x:Name="LeftPageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Canvas x:Name="LeftDiffCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <RichTextBlock x:Name="LeftRichText" Visibility="Collapsed" IsTextSelectionEnabled="True" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Vertical Divider -->
            <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Right PDF Pane -->
            <Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  AllowDrop="True" DragOver="OnPaneDragOver" Drop="OnRightPaneDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" Background="{ThemeResource WelcomeExcelDiffBgBrush}" Margin="0,0,8,0">
                            <FontIcon Glyph="&#xEA90;" FontSize="12" Foreground="{ThemeResource WelcomeExcelDiffFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="RightHeaderTitle" Grid.Column="1" Text="右侧修改文档 (.pdf)" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="OnChooseRightFileClicked" Width="28" Height="24" Padding="0" CornerRadius="4" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty State Drop Zone (Matching Mac Empty Drop Zone) -->
                <Grid x:Name="RightEmptyPanel" Grid.Row="1" Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource WelcomePdfDiffBgBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEA90;" FontSize="30" Foreground="{ThemeResource WelcomePdfDiffFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="RightEmptyPromptText" Text="拖拽 PDF 文件到此处，或点击下方按钮选择" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button Click="OnChooseRightFileClicked" HorizontalAlignment="Center" Padding="16,8" CornerRadius="8" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="13" />
                                <TextBlock x:Name="RightSelectBtnText" Text="选择右侧修改文档" FontWeight="Medium" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- High-Fidelity Paper Viewport with Floating Badge -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="RightScrollViewer" Padding="20"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ViewChanged="OnRightScrollViewChanged" Visibility="Collapsed">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,24">
                            <Border x:Name="RightPaperCard"
                                    Background="White"
                                    CornerRadius="4"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="RightPageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Canvas x:Name="RightDiffCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <RichTextBlock x:Name="RightRichText" Visibility="Collapsed" IsTextSelectionEnabled="True" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>

                    <!-- Floating Diff Badge (Matching Mac Floating Capsule Badge) -->
                    <Border x:Name="DiffBadgeCapsule" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="8,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center" />
                            <TextBlock x:Name="DiffBadgeText" Text="0 处差异区域" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftStatusText" Grid.Column="0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="RightStatusText" Grid.Column="1" TextAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
