<UserControl
    x:Class="WinCompare.UI.Views.UpdateAvailableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DragTransform" X="0" Y="0" />
    </UserControl.RenderTransform>

    <Border Width="540" Height="420"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Grid x:Name="DragHeader" Grid.Row="0" Margin="20,14,16,8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE777;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderTitleText" Text="软件更新" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button X -->
                <Button x:Name="CloseButton" Grid.Column="1" Click="OnCloseClicked"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Main Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,12">
                <StackPanel Spacing="14">
                    <!-- Icon & Notice Block -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="14" Width="56" Height="56" VerticalAlignment="Top">
                            <Image Source="ms-appx:///Assets/AppIcon.png" Width="56" Height="56" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="PromptHeadlineText" Text="发现 WinCompare 新版本！" FontSize="15" FontWeight="Bold" />
                            <TextBlock x:Name="PromptDetailText" Text="WinCompare 现已发布，是否立即下载更新？" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Grid>

                    <!-- Release Notes Card -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ReleaseNotesLabel" Text="版本更新说明：" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Height="165">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="ReleaseVersionBadge" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="ReleaseNotesBody" Text="暂无更新说明" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Skip Version Button -->
                    <Button x:Name="SkipVersionBtn" Grid.Column="0" Content="跳过此版本" Click="OnSkipClicked" Padding="12,5" CornerRadius="6" />

                    <!-- Later Button -->
                    <Button x:Name="LaterBtn" Grid.Column="1" Content="稍后提醒" Click="OnLaterClicked" Margin="10,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Padding="10,5" CornerRadius="6" />

                    <!-- Download / Install Primary Button -->
                    <Button x:Name="DownloadBtn" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnDownloadClicked" Padding="16,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock x:Name="DownloadBtnText" Text="立即下载更新" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
