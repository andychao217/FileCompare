<Page
    x:Class="WinCompare.UI.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AllowDrop="True" Background="Transparent"
                  DragOver="OnWelcomeDragOver" Drop="OnWelcomeDrop">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28" Padding="24" MaxWidth="760">

            <!-- Top App Branding -->
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <!-- App Icon Badge (macOS App Icon with continuous rounded corners) -->
                <Border CornerRadius="16" Width="72" Height="72" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="72" Height="72" />
                </Border>

                <TextBlock x:Name="AppTitleBlock" Text="WinCompare" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="AppSubtitleBlock" Text="基于 Rust 高吞吐引擎打造的 Windows 11 原生文件比对与三向合并利器"
                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <!-- 2x2 Mode Launch Cards -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Text Diff Card -->
                <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Padding="16" CornerRadius="12" Click="OnTextDiffClicked">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- macOS doc.text.fill icon -->
                        <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource WelcomeTextDiffBgBrush}">
                            <Viewbox Width="22" Height="22">
                                <Path Fill="{ThemeResource WelcomeTextDiffFgBrush}" Data="M6 2C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2H6ZM13 3.5L18.5 9H13V3.5ZM7 11H17V12.5H7V11ZM7 14.5H17V16H7V14.5ZM7 18H13V19.5H7V18Z" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TextDiffTitleBlock" Text="文本对比" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="TextDiffDescBlock" Text="双向 Myers 差异、字符高亮与 3-Way 合并" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Ctrl+N" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                </Button>

                <!-- Excel Diff Card -->
                <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Padding="16" CornerRadius="12" Click="OnExcelDiffClicked">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- macOS tablecells.fill icon -->
                        <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource WelcomeExcelDiffBgBrush}">
                            <Viewbox Width="22" Height="22">
                                <Path Fill="{ThemeResource WelcomeExcelDiffFgBrush}" Data="M4 4C4 2.89543 4.89543 2 6 2H18C19.1046 2 20 2.89543 20 4V20C20 21.1046 19.1046 22 18 22H6C4.89543 22 4 21.1046 4 20V4ZM6 3.5C5.72386 3.5 5.5 3.72386 5.5 4V7.5H11V3.5H6ZM12.5 3.5V7.5H18.5V4C18.5 3.72386 18.2761 3.5 18 3.5H12.5ZM5.5 9V14.5H11V9H5.5ZM12.5 9V14.5H18.5V9H12.5ZM5.5 16V20C5.5 20.2761 5.72386 20.5 6 20.5H11V16H5.5ZM12.5 16V20.5H18C18.2761 20.5 18.5 20.2761 18.5 20V16H12.5Z" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ExcelDiffTitleBlock" Text="表格对比" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="ExcelDiffDescBlock" Text="支持 .xlsx/.csv 百万行流式分页与单元格高亮" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="⇧Ctrl+E" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                </Button>

                <!-- Word Diff Card -->
                <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Padding="16" CornerRadius="12" Click="OnWordDiffClicked">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- macOS doc.richtext.fill icon -->
                        <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource WelcomeWordDiffBgBrush}">
                            <Viewbox Width="22" Height="22">
                                <Path Fill="{ThemeResource WelcomeWordDiffFgBrush}" Data="M6 2C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V8L14 2H6ZM13 3.5L18.5 9H13V3.5ZM7 11H12V12.5H7V11ZM7 14H17V15.5H7V14ZM7 17H17V18.5H7V17Z" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="WordDiffTitleBlock" Text="Word 对比" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="WordDiffDescBlock" Text="解析 .docx 段落、大纲树与嵌套表格差异" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="⇧Ctrl+D" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                </Button>

                <!-- Folder Diff Card -->
                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Padding="16" CornerRadius="12" Click="OnFolderDiffClicked">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- macOS folder.fill icon -->
                        <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource WelcomeFolderDiffBgBrush}">
                            <Viewbox Width="22" Height="22">
                                <Path Fill="{ThemeResource WelcomeFolderDiffFgBrush}" Data="M3 4C3 2.89543 3.89543 2 5 2H9.58579C10.1162 2 10.6249 2.21071 11 2.58579L12.4142 4H19C20.1046 4 21 4.89543 21 6V18C21 19.1046 20.1046 20 19 20H5C3.89543 20 3 19.1046 3 18V4Z" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FolderDiffTitleBlock" Text="文件夹对比" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="FolderDiffDescBlock" Text="多线程快速/哈希/全字节扫描与一键同步" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="⇧Ctrl+N" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Recent Comparisons Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RecentTitleBlock" Text="最近比对记录" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Button x:Name="ClearHistoryBtn" Grid.Column="1" Padding="8,3" 
                                Background="Transparent" BorderThickness="0" CornerRadius="4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Click="OnClearHistoryClicked">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="ClearHistoryBtnText" Text="一键清除" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Empty State Placeholder -->
                    <StackPanel x:Name="EmptyHistoryPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Padding="0,16">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="NoRecentBlock" Text="暂无最近比对记录，点击上方卡片开启比对" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- Dynamic Recent Records List -->
                    <ListView x:Name="RecentListView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRecentItemClicked">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="4,6">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{Binding DeleteTooltip}" Click="OnDeleteRecentItemClicked" Tag="{Binding Record}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Mode Icon with dedicated background badge -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{Binding IconBackgroundBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{Binding IconForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title, Path and Mode Badge -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="440" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="5,1" Background="{Binding BadgeBackgroundBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeName}" FontSize="10" FontWeight="Medium" Foreground="{Binding BadgeForegroundBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PathSummary}" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedDate}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <!-- Delete Single Record Button -->
                                    <Button Grid.Column="3" Width="28" Height="28" Padding="0"
                                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Click="OnDeleteRecentItemClicked"
                                            Tag="{Binding Record}"
                                            ToolTipService.ToolTip="{Binding DeleteTooltip}">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
