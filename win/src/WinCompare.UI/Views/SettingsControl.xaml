<UserControl
    x:Class="WinCompare.UI.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="DragTransform" X="0" Y="0" />
    </UserControl.RenderTransform>

    <Border Width="590" Height="560"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with Title & Close Button X -->
            <Grid x:Name="DragHeader" Grid.Row="0" Margin="20,14,16,8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DialogTitleText" Text="偏好设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Grid.Column="1" Click="OnCloseClicked"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Width="34" Height="34" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="关闭 (Close)">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

        <TabView x:Name="SettingsTabs" Grid.Row="1" IsAddTabButtonVisible="False" Background="Transparent">
            <TabView.TabItems>
                <!-- 1. 常规设置 (General) -->
                <TabViewItem x:Name="GeneralTabItem" Header="常规" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE713;" />
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                        <StackPanel Spacing="16">
                            <!-- Language & Appearance Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <!-- Appearance -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="ThemeLabel" Text="外观主题" FontWeight="Medium" FontSize="14" />
                                            <TextBlock x:Name="ThemeSubLabel" Text="Windows 11 Mica 材质与深浅色切换" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="150" SelectedIndex="0" SelectionChanged="OnThemeChanged">
                                            <ComboBoxItem x:Name="ThemeFollowSystemItem" Content="跟随系统" />
                                            <ComboBoxItem x:Name="ThemeDarkItem" Content="深色模式 (Dark)" />
                                            <ComboBoxItem x:Name="ThemeLightItem" Content="浅色模式 (Light)" />
                                        </ComboBox>
                                    </Grid>

                                    <MenuFlyoutSeparator />

                                    <!-- Language -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="LangLabel" Text="界面显示语言" FontWeight="Medium" FontSize="14" />
                                            <TextBlock x:Name="LangSubLabel" Text="选择 WinCompare 界面的显示语言" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="150" SelectionChanged="OnLanguageChanged">
                                            <ComboBoxItem Content="🌐 跟随系统 (System)" Tag="Auto" />
                                            <ComboBoxItem Content="🇨🇳 简体中文" Tag="ZhHans" />
                                            <ComboBoxItem Content="🇺🇸 English" Tag="En" />
                                            <ComboBoxItem Content="🇯🇵 日本語" Tag="Ja" />
                                        </ComboBox>
                                    </Grid>

                                    <MenuFlyoutSeparator />

                                    <!-- Default Encoding -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="EncodingLabel" Text="默认文件编码" FontWeight="Medium" FontSize="14" />
                                            <TextBlock Text="文件读取与写入时的字符集编码" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="EncodingCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="150" SelectedIndex="0" SelectionChanged="OnEncodingChanged">
                                            <ComboBoxItem Content="UTF-8" />
                                            <ComboBoxItem Content="GBK / GB18030" />
                                            <ComboBoxItem Content="UTF-16 LE" />
                                            <ComboBoxItem Content="Shift-JIS" />
                                            <ComboBoxItem Content="ISO-8859-1" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Core Engine Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock x:Name="CoreEngineTitle" Text="核心引擎" FontWeight="Medium" FontSize="14" />
                                    
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DiffEngineLabel" Text="比对核心引擎" VerticalAlignment="Center" FontSize="13" />
                                        <ComboBox x:Name="EngineCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="160" SelectedIndex="0" SelectionChanged="OnEngineSelectionChanged">
                                            <ComboBoxItem x:Name="EngineRustFirstItem" Content="自动优选 (Rust First)" />
                                            <ComboBoxItem x:Name="EngineRustOnlyItem" Content="Rust 原生引擎 (maccompare_ffi)" />
                                            <ComboBoxItem x:Name="EngineFallbackItem" Content="托管备用引擎 (C# Fallback)" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="EngineStatusLabel" Text="当前引擎状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="{ThemeResource StatusSuccessBrush}" />
                                            <TextBlock x:Name="EngineStatusText" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Diff Preferences Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="DiffPrefLabel" Text="默认比对偏好" FontWeight="Medium" FontSize="14" />
                                    
                                    <ToggleSwitch x:Name="IgnoreWsSwitch" Header="默认忽略空白字符 (Ignore Whitespace)" IsOn="False" Toggled="OnIgnoreWsToggled" />
                                    <ToggleSwitch x:Name="IgnoreCaseSwitch" Header="默认忽略大小写 (Ignore Case)" IsOn="False" Toggled="OnIgnoreCaseToggled" />
                                    
                                    <ToggleSwitch x:Name="BackupSwitch" IsOn="True" Toggled="OnBackupToggled">
                                        <ToggleSwitch.Header>
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="BackupTitleText" Text="保存时自动创建 .bak 备份文件" FontSize="13" />
                                                <TextBlock x:Name="BackupDescText" Text="在覆盖保存前自动复制一份 .bak 文件，防止意外数据丢失。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToggleSwitch.Header>
                                    </ToggleSwitch>

                                    <ToggleSwitch x:Name="AutoUpdateSwitch" Header="启动时自动检查更新" IsOn="True" Toggled="OnAutoUpdateToggled" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- 2. 文件夹对比 (Folder Diff) -->
                <TabViewItem x:Name="FolderDiffTabItem" Header="文件夹对比" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xED25;" />
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                        <StackPanel Spacing="16">
                            <!-- Default Compare Mode Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="DefaultCompareModeLabel" Text="默认比对模式" FontWeight="Medium" FontSize="14" />
                                    <StackPanel Spacing="8">
                                        <RadioButton x:Name="QuickCompareRadio" GroupName="FolderCompareMode" IsChecked="True" Content="快速比对 (时间戳与文件大小 - Quick Compare)" Checked="OnFolderModeChecked" />
                                        <RadioButton x:Name="DeepHashCompareRadio" GroupName="FolderCompareMode" Content="深度哈希比对 (CRC32 内容校验 - Deep Hash Compare)" Checked="OnFolderModeChecked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Default Excluded Patterns Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="ExcludedPatternsLabel" Text="默认排除过滤规则" FontWeight="Medium" FontSize="14" />
                                        <TextBlock x:Name="ExcludedPatternsDesc" Text="在文件夹比对与目录树扫描时自动忽略匹配的文件或目录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox x:Name="ExcludedPatternsBox" Text=".git, .DS_Store, node_modules, target, build" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" TextChanged="OnExcludedPatternsChanged" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- 3. AI 智能引擎 (AI Engine - 暂时隐藏) -->
                <TabViewItem x:Name="AiTabItem" Header="AI 智能引擎" IsClosable="False" Visibility="Collapsed">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE945;" />
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                        <StackPanel Spacing="16">
                            <!-- Execution Mode Selector -->
                            <RadioButtons x:Name="AiExecutionModeRadio" SelectedIndex="0" SelectionChanged="OnAiModeChanged">
                                <RadioButton x:Name="RadioAiLocal" Content="本地端侧离线模型 (SLM / 零出网 / 100% 隐私安全)" />
                                <RadioButton x:Name="RadioAiCloud" Content="云端大模型 API (DeepSeek / OpenAI / 本地 Ollama)" />
                            </RadioButtons>

                            <!-- Local SLM Section -->
                            <StackPanel x:Name="LocalSlmPanel" Spacing="16">
                                <!-- Model Library Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="ModelLibraryLabel" Text="本地模型库" FontWeight="Medium" FontSize="14" />
                                        
                                        <!-- Gemma 3 1B -->
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource AIAccentBrush}" />
                                                            <TextBlock Text="Google Gemma 3 1B" FontWeight="SemiBold" FontSize="13" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="Gemma1bDesc" Text="轻量低功耗 · 极速启动 · 适合日常代码对比 (780 MB)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Actions Right Area -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <!-- Ready State Panel -->
                                                        <StackPanel x:Name="Gemma1bReadyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                            <Border x:Name="Gemma1bActiveBadge" Background="{ThemeResource SuccessSubtleBgBrush}" CornerRadius="10" Padding="8,3">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource StatusSuccessBrush}" />
                                                                    <TextBlock x:Name="Gemma1bInUseText" Text="正在使用" FontSize="11" Foreground="{ThemeResource StatusSuccessBrush}" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Button x:Name="Gemma1bSelectBtn" Content="启用" FontSize="11" Padding="8,3" Click="OnSelectGemma1bClicked" Visibility="Collapsed" />
                                                            <Button x:Name="Gemma1bDeleteBtn" Content="清理" FontSize="11" Padding="6,2" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="OnDeleteGemma1bClicked" ToolTipService.ToolTip="清理本地模型文件释放空间" />
                                                        </StackPanel>

                                                        <!-- Not Downloaded State -->
                                                        <Button x:Name="Gemma1bDownloadBtn" Click="OnDownloadGemma1bClicked" Style="{StaticResource AccentButtonStyle}" Padding="10,4" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                                <TextBlock x:Name="Gemma1bDownloadText" Text="下载模型" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Downloading State Cancel Button -->
                                                        <Button x:Name="Gemma1bCancelBtn" Click="OnCancelGemma1bClicked" Visibility="Collapsed" Padding="8,3" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                                <TextBlock x:Name="Gemma1bCancelText" Text="取消" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Downloading Progress Bar & Stats -->
                                                <StackPanel x:Name="Gemma1bDownloadProgressPanel" Spacing="4" Visibility="Collapsed">
                                                    <ProgressBar x:Name="Gemma1bProgressBar" Value="0" Maximum="100" />
                                                    <Grid>
                                                        <TextBlock x:Name="Gemma1bProgressPercentText" Text="0%" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="Gemma1bProgressStatsText" Text="准备中..." FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Error Panel -->
                                                <StackPanel x:Name="Gemma1bErrorPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                    <TextBlock x:Name="Gemma1bErrorText" Text="下载失败" FontSize="11" Foreground="{ThemeResource StatusDangerBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="Gemma1bRetryBtn" Content="重试" FontSize="11" Padding="6,2" Click="OnDownloadGemma1bClicked" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Gemma 3 4B -->
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="14,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource AIAccentBrush}" />
                                                            <TextBlock Text="Google Gemma 3 4B" FontWeight="SemiBold" FontSize="13" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="Gemma4bDesc" Text="高精度逻辑推理 · 深度语义分析 · 复杂重构比对 (2.5 GB)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Actions Right Area -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <!-- Ready State Panel -->
                                                        <StackPanel x:Name="Gemma4bReadyPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                            <Border x:Name="Gemma4bActiveBadge" Background="{ThemeResource SuccessSubtleBgBrush}" CornerRadius="10" Padding="8,3">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource StatusSuccessBrush}" />
                                                                    <TextBlock x:Name="Gemma4bInUseText" Text="正在使用" FontSize="11" Foreground="{ThemeResource StatusSuccessBrush}" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Button x:Name="Gemma4bSelectBtn" Content="启用" FontSize="11" Padding="8,3" Click="OnSelectGemma4bClicked" Visibility="Collapsed" />
                                                            <Button x:Name="Gemma4bDeleteBtn" Content="清理" FontSize="11" Padding="6,2" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="OnDeleteGemma4bClicked" ToolTipService.ToolTip="清理本地模型文件释放空间" />
                                                        </StackPanel>

                                                        <!-- Not Downloaded State -->
                                                        <Button x:Name="Gemma4bDownloadBtn" Click="OnDownloadGemma4bClicked" Style="{StaticResource AccentButtonStyle}" Padding="10,4" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                                                <TextBlock x:Name="Gemma4bDownloadText" Text="下载模型" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Downloading State Cancel Button -->
                                                        <Button x:Name="Gemma4bCancelBtn" Click="OnCancelGemma4bClicked" Visibility="Collapsed" Padding="8,3" CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                                <TextBlock x:Name="Gemma4bCancelText" Text="取消" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Downloading Progress Bar & Stats -->
                                                <StackPanel x:Name="Gemma4bDownloadProgressPanel" Spacing="4" Visibility="Collapsed">
                                                    <ProgressBar x:Name="Gemma4bProgressBar" Value="0" Maximum="100" />
                                                    <Grid>
                                                        <TextBlock x:Name="Gemma4bProgressPercentText" Text="0%" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="Gemma4bProgressStatsText" Text="准备中..." FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Error Panel -->
                                                <StackPanel x:Name="Gemma4bErrorPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                    <TextBlock x:Name="Gemma4bErrorText" Text="下载失败" FontSize="11" Foreground="{ThemeResource StatusDangerBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="Gemma4bRetryBtn" Content="重试" FontSize="11" Padding="6,2" Click="OnDownloadGemma4bClicked" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Smart Memory Management Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <ToggleSwitch x:Name="AutoReleaseMemorySwitch" IsOn="True" Toggled="OnAutoReleaseMemoryToggled">
                                        <ToggleSwitch.Header>
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="AutoReleaseTitle" Text="自动释放显存/内存" FontSize="13" FontWeight="Medium" />
                                                <TextBlock x:Name="AutoReleaseDesc" Text="比对完成闲置 5 分钟后自动卸载模型释放显存与内存，保障系统流畅。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ToggleSwitch.Header>
                                    </ToggleSwitch>
                                </Border>
                            </StackPanel>

                            <!-- Cloud LLM API Section -->
                            <StackPanel x:Name="CloudLlmPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Provider Preset Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="PresetLabel" Text="服务商预设" FontWeight="Medium" FontSize="14" />
                                            <TextBlock x:Name="PresetSubLabel" Text="选择主流 AI 大模型服务商快速填充" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ProviderPresetCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="160" SelectedIndex="0" SelectionChanged="OnPresetChanged">
                                            <ComboBoxItem Content="DeepSeek (推荐 / 高性价比)" />
                                            <ComboBoxItem Content="OpenAI (GPT-4o)" />
                                            <ComboBoxItem Content="Claude (Anthropic)" />
                                            <ComboBoxItem Content="Ollama (本地私有化)" />
                                            <ComboBoxItem Content="自定义 (Custom)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- API Config Card -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="14">
                                        <TextBlock x:Name="ApiConfigTitle" Text="API 配置信息" FontWeight="Medium" FontSize="14" />
                                        
                                        <TextBox x:Name="ApiBaseUrlBox" Header="API Base URL" Text="https://api.deepseek.com/v1" TextChanged="OnApiConfigChanged" />
                                        
                                        <!-- API Key with show/hide eye toggle -->
                                        <Grid>
                                            <PasswordBox x:Name="ApiKeyPasswordBox" Header="API Key" Password="sk-..." PasswordChanged="OnApiKeyPasswordChanged" />
                                            <TextBox x:Name="ApiKeyTextBox" Header="API Key" Visibility="Collapsed" TextChanged="OnApiKeyTextChanged" />
                                            <Button x:Name="ToggleKeyVisibilityBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                                    Background="Transparent" BorderThickness="0" Padding="6" Click="OnToggleApiKeyVisibility">
                                                <FontIcon x:Name="EyeIcon" Glyph="&#xE7B3;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Button>
                                        </Grid>

                                        <TextBox x:Name="ApiModelNameBox" Header="模型名称" Text="deepseek-chat" TextChanged="OnApiConfigChanged" />

                                        <!-- Test Connection Button & Result -->
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" VerticalAlignment="Center">
                                            <Button x:Name="TestConnectionBtn" Click="OnTestConnectionClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                                                    <TextBlock x:Name="TestConnBtnText" Text="测试接口连通性" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <ProgressRing x:Name="TestProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                            <TextBlock x:Name="TestResultText" Text="" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- 3. 关于 (About) -->
                <TabViewItem x:Name="AboutTabItem" Header="关于" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE946;" />
                    </TabViewItem.IconSource>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,24">
                        <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="420">
                            <Border CornerRadius="16" Width="64" Height="64" HorizontalAlignment="Center">
                                <Image Source="ms-appx:///Assets/AppIcon.png" Width="64" Height="64" />
                            </Border>
                            
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="WinCompare" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="VersionTextBlock" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Native Architecture Capsule Badge -->
                            <Border Background="{ThemeResource SuccessSubtleBgBrush}" BorderBrush="{ThemeResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                <TextBlock x:Name="NativeArchBadgeText" Text="x64 / ARM64 Windows Native · Rust Driven" FontSize="11" Foreground="{ThemeResource StatusSuccessBrush}" FontWeight="Medium" />
                            </Border>

                            <TextBlock x:Name="AboutDescText" Text="基于 Rust 高性能引擎驱动的现代化 Windows 11 双向/三向代码与表格差异比对利器。前端采用 C# 14 + .NET 10 + WinUI 3 原生渲染。" 
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />

                            <MenuFlyoutSeparator Margin="0,4" />

                            <!-- Check for Updates Button -->
                            <Button x:Name="CheckUpdateBtn" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="16,6" CornerRadius="6" Click="OnCheckUpdateClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="UpdateIcon" Glyph="&#xE777;" FontSize="13" />
                                    <TextBlock x:Name="CheckUpdateBtnText" Text="检查更新" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="UpdateProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" />
                            <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                            <HyperlinkButton Content="GitHub: https://github.com/andychao217/FileCompare" NavigateUri="https://github.com/andychao217/FileCompare" HorizontalAlignment="Center" FontSize="11" Margin="0,-4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
        </Grid>
    </Border>
</UserControl>
