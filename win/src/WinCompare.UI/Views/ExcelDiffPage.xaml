<Page
    x:Class="WinCompare.UI.Views.ExcelDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CommandBar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarElementContainer VerticalAlignment="Center" Margin="8,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="SheetLabel" Text="工作表:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="SheetComboBox" PlaceholderText="选择工作表" SelectionChanged="OnSheetChanged" MinWidth="130" Height="32" VerticalAlignment="Center" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarSeparator />
            <AppBarButton x:Name="OpenFileBtn" Icon="OpenFile" Label="打开文件">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="PickLeftExcelItem" Text="选择左侧表格 (Left)..." Click="OnPickLeftExcelClicked" />
                        <MenuFlyoutItem x:Name="PickRightExcelItem" Text="选择右侧表格 (Right)..." Click="OnPickRightExcelClicked" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="PrevDiffBtn" Icon="Back" Label="上一处差异" Click="OnPrevDiffClicked" />
            <AppBarButton x:Name="NextDiffBtn" Icon="Forward" Label="下一处差异" Click="OnNextDiffClicked" />
            <AppBarToggleButton x:Name="DiffOnlyToggle" Icon="Filter" Label="仅差异" Click="OnDiffOnlyToggled" />
            <AppBarSeparator />
            <AppBarElementContainer VerticalAlignment="Center">
                <AutoSuggestBox x:Name="ExcelSearchBox" PlaceholderText="搜索单元格..." QueryIcon="Find" Width="180" Height="32" VerticalAlignment="Center" Margin="4,0" TextChanged="OnSearchTextChanged" />
            </AppBarElementContainer>
            <AppBarSeparator />
            <AppBarButton x:Name="SwapSidesBtn" Icon="Switch" Label="交换左右" Click="OnSwapSidesClicked" />
            <AppBarButton x:Name="RefreshBtn" Icon="Sync" Label="刷新比对" Click="OnRefreshClicked" />
            <AppBarButton x:Name="ExportReportBtn" Icon="SaveLocal" Label="导出差异" Click="OnExportDiffClicked" />
            <AppBarButton x:Name="ClearAllBtn" Icon="Delete" Label="清空" Click="OnClearAllClicked" />

            <CommandBar.Content>
                <Grid Height="48" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border x:Name="DiffBadgeBorder" VerticalAlignment="Center" Background="#203B82F6" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="DiffBadge" Text="0 处差异" FontSize="12" FontWeight="SemiBold" Foreground="#3B82F6" />
                    </Border>
                </Grid>
            </CommandBar.Content>
        </CommandBar>

        <!-- Excel Files Bar with Drag & Drop -->
        <Grid Grid.Row="1" Padding="16,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Excel Header -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6"
                    AllowDrop="True" DragOver="OnLeftExcelDragOver" Drop="OnLeftExcelDrop">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xF0EC;" Foreground="#22C55E" FontSize="14" />
                        <TextBlock x:Name="LeftExcelPathText" Text="拖入或选择左侧 Excel / CSV 文件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="LeftBrowseBtn" HorizontalAlignment="Right" Content="浏览" FontSize="11" Padding="8,2" Click="OnPickLeftExcelClicked" />
                </Grid>
            </Border>

            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Right Excel Header -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6"
                    AllowDrop="True" DragOver="OnRightExcelDragOver" Drop="OnRightExcelDrop">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xF0EC;" Foreground="#22C55E" FontSize="14" />
                        <TextBlock x:Name="RightExcelPathText" Text="拖入或选择右侧 Excel / CSV 文件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="RightBrowseBtn" HorizontalAlignment="Right" Content="浏览" FontSize="11" Padding="8,2" Click="OnPickRightExcelClicked" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main Synchronized Dual-Grid Viewport -->
        <Grid Grid.Row="2">
            <!-- Vertical Center Divider Line -->
            <Border HorizontalAlignment="Center" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Stretch" />

            <!-- Table Header -->
            <Grid Height="26" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Padding="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LeftColRowHeader" Text="行号" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LeftColStatusHeader" Grid.Column="1" Text="状态" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LeftColContentHeader" Grid.Column="2" Text="左侧单元格内容" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Grid Grid.Column="2" Padding="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RightColRowHeader" Text="行号" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RightColStatusHeader" Grid.Column="1" Text="状态" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RightColContentHeader" Grid.Column="2" Text="右侧单元格内容" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Synchronized Rows ListView -->
            <ListView x:Name="ExcelRowsList" Margin="0,26,0,0" SelectionMode="Single" Padding="0" SelectionChanged="OnRowSelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="24" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Row -->
                            <Grid Grid.Column="0" Background="{Binding LeftBgBrush}" Padding="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RowIndexText}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding LeftRowFormatted}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <!-- Right Row -->
                            <Grid Grid.Column="2" Background="{Binding RightBgBrush}" Padding="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RowIndexText}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding RightRowFormatted}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Visible">
                <FontIcon Glyph="&#xF0EC;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyPromptText" Text="请选择左侧和右侧 Excel (.xlsx, .xls, .csv) 文件以开始比对" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button x:Name="EmptyActionBtn" Content="选择表格文件" HorizontalAlignment="Center" Click="OnPickLeftExcelClicked" />
            </StackPanel>
        </Grid>

        <!-- Row Detail Inspector -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="InspectorTitle" Text="单元格明细检查器 (点击任意行查看)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InspectorContent" Text="尚未选择行" FontSize="12" FontFamily="{StaticResource CodeFontFamily}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Bottom Sheet Switcher & Status Bar -->
        <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="StatusInfoText" Text="未加载" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Text="Rust calamine / SIMD CRC32 Core" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>
