<Page
    x:Class="WinCompare.UI.Views.ExcelDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar (Row 1) -->
            <RowDefinition Height="Auto" /> <!-- Filter & Search Bar (Row 2) -->
            <RowDefinition Height="32" />   <!-- Dual File Header (Row 3) -->
            <RowDefinition Height="*" />    <!-- Main Viewport / Empty State -->
            <RowDefinition Height="Auto" /> <!-- Inspector (Collapsible) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar (Matching Mac Image 1) -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group: Navigation & Ignore Switches -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- 上一个差异 -->
                    <Button x:Name="PrevDiffBtn" Click="OnPrevDiffClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="上一个差异 (F7)">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74A;" FontSize="11" />
                            <TextBlock x:Name="PrevDiffText" Text="上一个差异" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 下一个差异 -->
                    <Button x:Name="NextDiffBtn" Click="OnNextDiffClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="下一个差异 (F8)">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74B;" FontSize="11" />
                            <TextBlock x:Name="NextDiffText" Text="下一个差异" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />

                    <!-- 忽略空白符 Switch -->
                    <Border x:Name="WhitespaceContainer" CornerRadius="4" Padding="6,2" Background="Transparent"
                            PointerPressed="OnWhitespaceContainerClicked" ToolTipService.ToolTip="比对时忽略空格和制表符差异">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="WhitespaceLabel" Text="忽略空白符" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ToggleSwitch x:Name="WhitespaceSwitch" OffContent="" OnContent="" Toggled="OnDiffOptionsChanged" />
                        </StackPanel>
                    </Border>

                    <!-- 忽略大小写 Switch -->
                    <Border x:Name="CaseContainer" CornerRadius="4" Padding="6,2" Background="Transparent" Margin="2,0,0,0"
                            PointerPressed="OnCaseContainerClicked" ToolTipService.ToolTip="比对时忽略字母大小写差异">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="CaseLabel" Text="忽略大小写" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ToggleSwitch x:Name="CaseSwitch" OffContent="" OnContent="" Toggled="OnDiffOptionsChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Group: Rules, Swap, Refresh, Merge Actions, Clear -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- 比对规则 / 工作表选择 -->
                    <Button x:Name="RuleSettingsBtn" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="比对规则与工作表切换">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="11" />
                            <TextBlock x:Name="RuleBtnText" Text="比对规则" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="10" Width="240" Padding="4">
                                    <TextBlock Text="选择工作表 (Worksheet)" FontWeight="SemiBold" FontSize="12" />
                                    <ComboBox x:Name="SheetComboBox" PlaceholderText="选择工作表" SelectionChanged="OnSheetChanged" HorizontalAlignment="Stretch" />
                                    <Button x:Name="ExportReportBtn" Click="OnExportDiffClicked" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE78C;" FontSize="12" />
                                            <TextBlock Text="导出差异报告..." FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- 左右对调 -->
                    <Button x:Name="SwapSidesBtn" Click="OnSwapSidesClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="交换左右两侧表格">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8EE;" FontSize="11" />
                            <TextBlock x:Name="SwapSidesText" Text="左右对调" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 刷新 -->
                    <Button x:Name="RefreshBtn" Click="OnRefreshClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="重新比对表格">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock x:Name="RefreshText" Text="刷新" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />

                    <!-- 采纳左侧 -->
                    <Button x:Name="TakeLeftBtn" Click="OnTakeLeftClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="采纳左侧内容">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE749;" FontSize="11" />
                            <TextBlock x:Name="TakeLeftText" Text="采纳左侧" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 采纳右侧 -->
                    <Button x:Name="TakeRightBtn" Click="OnTakeRightClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="采纳右侧内容">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE748;" FontSize="11" />
                            <TextBlock x:Name="TakeRightText" Text="采纳右侧" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />

                    <!-- 一键清空 -->
                    <Button x:Name="ClearAllBtn" Click="OnClearAllClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="一键清空表格与比对结果">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                            <TextBlock x:Name="ClearAllText" Text="一键清空" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filter & Search Bar (Matching Mac Image 1 Row 2) -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,5">
            <Grid>
                <!-- Segmented filter buttons on left -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="FilterAllBtn" Click="OnFilterAllClicked"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            CornerRadius="4" Padding="12,3" Height="26" FontSize="11" FontWeight="SemiBold">
                        <TextBlock x:Name="FilterAllText" Text="全部" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="FilterDiffBtn" Click="OnFilterDiffOnlyClicked"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="4" Padding="12,3" Height="26" FontSize="11">
                        <TextBlock x:Name="FilterDiffText" Text="仅差异" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="FilterSameBtn" Click="OnFilterSameOnlyClicked"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="4" Padding="12,3" Height="26" FontSize="11">
                        <TextBlock x:Name="FilterSameText" Text="仅相同" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Search box on right -->
                <AutoSuggestBox x:Name="ExcelSearchBox" HorizontalAlignment="Right"
                                PlaceholderText="搜索与过滤段落..." QueryIcon="Find"
                                Width="240" Height="28" VerticalAlignment="Center"
                                TextChanged="OnSearchTextChanged" FontSize="11" />
            </Grid>
        </Border>

        <!-- 3. Dual File Headers (Matching Mac Image 1 Row 3) -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Excel Header -->
                <Grid Grid.Column="0" Padding="12,0" AllowDrop="True" DragOver="OnLeftExcelDragOver" Drop="OnLeftExcelDrop">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE944;" FontSize="12" Foreground="#22C55E" />
                        <TextBlock x:Name="LeftExcelHeader" Text="源文件 (左侧)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </StackPanel>
                    <Button x:Name="LeftBrowseBtn" HorizontalAlignment="Right" Content="选择..." FontSize="11" Padding="8,2" Click="OnPickLeftExcelClicked" CornerRadius="4" Height="24" VerticalAlignment="Center" />
                </Grid>

                <!-- Center Divider -->
                <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                <!-- Right Excel Header -->
                <Grid Grid.Column="2" Padding="12,0" AllowDrop="True" DragOver="OnRightExcelDragOver" Drop="OnRightExcelDrop">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE944;" FontSize="12" Foreground="#22C55E" />
                        <TextBlock x:Name="RightExcelHeader" Text="目标文件 (右侧)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </StackPanel>
                    <Button x:Name="RightBrowseBtn" HorizontalAlignment="Right" Content="选择..." FontSize="11" Padding="8,2" Click="OnPickRightExcelClicked" CornerRadius="4" Height="24" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Main Viewport Area (Empty State vs Diff Grid) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Empty State Container (Exact Match of Mac Image 1) -->
            <Grid x:Name="EmptyStateContainer" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Drop Zone -->
                <Border Grid.Column="0" Background="Transparent" AllowDrop="True" DragOver="OnLeftExcelDragOver" Drop="OnLeftExcelDrop">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE8F4;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LeftEmptyTitle" Text="未选择文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="LeftEmptyDesc" Text="拖拽文件至此处或点击下方按钮选择" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <Button x:Name="LeftPickBtn" Content="选择源文件..." Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="18,8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Click="OnPickLeftExcelClicked" />
                    </StackPanel>
                </Border>

                <!-- Center Divider -->
                <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                <!-- Right Drop Zone -->
                <Border Grid.Column="2" Background="Transparent" AllowDrop="True" DragOver="OnRightExcelDragOver" Drop="OnRightExcelDrop">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE77C;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RightEmptyTitle" Text="未选择文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="RightEmptyDesc" Text="拖拽文件至此处或点击下方按钮选择" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <Button x:Name="RightPickBtn" Content="选择目标文件..." Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="18,8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Click="OnPickRightExcelClicked" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active Synchronized Dual Grid Viewport -->
            <Grid x:Name="DiffGridContainer" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Column Headers -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Padding="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LeftColRowHeader" Text="行号" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LeftColStatusHeader" Grid.Column="1" Text="状态" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LeftColContentHeader" Grid.Column="2" Text="左侧单元格内容" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                        <Grid Grid.Column="2" Padding="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RightColRowHeader" Text="行号" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RightColStatusHeader" Grid.Column="1" Text="状态" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RightColContentHeader" Grid.Column="2" Text="右侧单元格内容" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Synchronized Rows ListView -->
                <ListView x:Name="ExcelRowsList" Grid.Row="1" SelectionMode="Single" Padding="0" SelectionChanged="OnRowSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="24" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Height="24" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Row -->
                                    <Grid Grid.Column="0" Background="{Binding LeftBgBrush}" Padding="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RowIndexText}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding LeftRowFormatted}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                                    <!-- Right Row -->
                                    <Grid Grid.Column="2" Background="{Binding RightBgBrush}" Padding="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RowIndexText}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding RightRowFormatted}" FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- 5. Row Detail Inspector -->
        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="InspectorTitle" Text="单元格明细检查器 (点击任意行查看)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="InspectorContent" Text="尚未选择行" FontSize="12" FontFamily="{StaticResource CodeFontFamily}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 6. Bottom Status Bar -->
        <Border Grid.Row="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock x:Name="StatusInfoText" HorizontalAlignment="Left" Text="未加载" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="DiffBadge" Text="0 处差异" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Rust calamine / SIMD CRC32 Core" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
