<Window
    x:Class="WinCompare.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinCompare.UI.Views"
    Title="WinCompare">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Extended Title Bar Area -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="8,0,0,0"
              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Main TabView in TitleBar with Uniform Tab Widths -->
            <TabView x:Name="MainTabView"
                     x:FieldModifier="public"
                     Grid.Column="0"
                     VerticalAlignment="Stretch"
                     TabWidthMode="Equal"
                     CloseButtonOverlayMode="Always"
                     IsAddTabButtonVisible="False"
                     CanReorderTabs="False"
                     CanDragTabs="False"
                     CanTearOutTabs="False"
                     TabCloseRequested="OnTabCloseRequested">
                <TabView.TabItems>
                    <TabViewItem x:Name="WelcomeTabItem" Tag="Welcome" Header="WinCompare" IsClosable="False" MaxWidth="220">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE80F;" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </TabView.TabItems>


                <!-- Clean Dropdown (v) Button and custom drag region -->
                <TabView.TabStripFooter>
                    <Grid VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="TabMenuBtn"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="4,0,4,0"
                                Width="28" Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4">
                            <FontIcon Glyph="&#xE710;" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="TabMenuFlyout" Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem x:Name="MenuTextDiff" Text="&#x6587;&#x672C;&#x5BF9;&#x6BD4;" Click="OnNewTextDiffMenuClicked" KeyboardAcceleratorTextOverride="Ctrl+N">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MenuExcelDiff" Text="&#x8868;&#x683C;&#x5BF9;&#x6BD4;" Click="OnNewExcelDiffMenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xF0EC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MenuWordDiff" Text="Word &#x5BF9;&#x6BD4;" Click="OnNewWordDiffMenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+D">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A5;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MenuPdfDiff" Text="PDF &#x5BF9;&#x6BD4;" Click="OnNewPdfDiffMenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+P">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEA90;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MenuFolderDiff" Text="&#x6587;&#x4EF6;&#x5939;&#x5BF9;&#x6BD4;" Click="OnNewFolderDiffMenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+N">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED25;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MenuThreeWayMerge" Text="&#x4E09;&#x5411;&#x5408;&#x5E76;" Click="OnNewThreeWayMergeMenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+M">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8D7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator />

                                    <!-- Recent History SubItem (&#x4E8C;&#x7EA7;&#x83DC;&#x5355;&#x5FEB;&#x901F;&#x6253;&#x5F00;&#x5386;&#x53F2;&#x8BB0;&#x5F55;) -->
                                    <MenuFlyoutSubItem x:Name="MenuRecentHistory" Text="&#x6700;&#x8FD1;&#x6BD4;&#x5BF9;&#x8BB0;&#x5F55;" />

                                    <MenuFlyoutSeparator />

                                    <!-- Settings (Ctrl+,) -->
                                    <MenuFlyoutItem x:Name="MenuSettings" Text="&#x504F;&#x597D;&#x8BBE;&#x7F6E;" Click="OnSettingsClicked" KeyboardAcceleratorTextOverride="Ctrl+,">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator />

                                    <!-- Check for Updates -->
                                    <MenuFlyoutItem x:Name="MenuCheckUpdate" Text="&#x68C0;&#x67E5;&#x66F4;&#x65B0;..." Click="OnMenuCheckUpdateClicked">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE777;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <!-- Help & User Guide (F1) -->
                                    <MenuFlyoutItem x:Name="MenuHelp" Text="&#x5E2E;&#x52A9;&#x4E0E;&#x7528;&#x6237;&#x6307;&#x5357;" Click="OnHelpClicked" KeyboardAcceleratorTextOverride="F1">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE897;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <!-- About WinCompare -->
                                    <MenuFlyoutItem x:Name="MenuAbout" Text="&#x5173;&#x4E8E; WinCompare" Click="OnAboutClicked">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Dedicated draggable caption area for moving the window -->
                        <Border x:Name="CustomDragRegion"
                                Grid.Column="1"
                                Background="Transparent"
                                MinWidth="40"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>
                </TabView.TabStripFooter>
            </TabView>
            
            <!-- Tab Drop Insertion Indicator Overlay (Fluent Design 150ms Transition) -->
            <Canvas x:Name="TabDropCanvas" Grid.Column="0" IsHitTestVisible="False" VerticalAlignment="Stretch" Visibility="Collapsed">
                <Border x:Name="TabInsertionIndicator"
                        Width="2.5"
                        Height="28"
                        CornerRadius="1.25"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0"
                        Canvas.Top="6"
                        Canvas.Left="0">
                    <Border.Transitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </Border.Transitions>
                </Border>
            </Canvas>

            <!-- Reserved Right Margin for System Caption Controls (Min/Max/Close) -->
            <Border Grid.Column="1" Width="140" Background="Transparent" />
        </Grid>

        <!-- Main Content Area with Page State Preservation and Zero-Flicker Viewport Switching -->
        <Grid x:Name="TabContentGrid" Grid.Row="1" AllowDrop="True" Background="Transparent"
              DragOver="OnTabContentGridDragOver" Drop="OnTabContentGridDrop" />

        <!-- Administrator Elevation Warning InfoBar (UIPI Notification) -->
        <InfoBar x:Name="UipiWarningInfoBar" Grid.Row="1" VerticalAlignment="Top" Canvas.ZIndex="100"
                 Severity="Warning" IsOpen="False" IsClosable="True"
                 Title="管理员运行模式提示"
                 Message="检测到当前应用以管理员身份运行。Windows UIPI 机制会拦截文件资源管理器拖拽文件进窗口，如需使用拖拽请在普通权限终端下启动应用。" />

        <!-- In-App Draggable Modal Dialog Overlay -->
        <Grid x:Name="DialogOverlay" Grid.Row="0" Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource OverlayDimBackgroundBrush}">
            <ContentPresenter x:Name="DialogContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Grid>

        <!-- Floating Dragged Tab Ghost Preview (Fluent Design) -->
        <Canvas x:Name="TabGhostCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="TabGhostPreview"
                    Visibility="Collapsed"
                    CornerRadius="6"
                    Height="32"
                    Padding="12,0,12,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1.5"
                    Opacity="0.9"
                    Canvas.Left="0"
                    Canvas.Top="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="TabGhostIcon" FontSize="14" Glyph="&#xE8A5;" />
                    <TextBlock x:Name="TabGhostTitle" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Text="Tab" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
