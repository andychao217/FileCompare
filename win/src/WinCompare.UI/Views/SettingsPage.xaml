<Page
    x:Class="WinCompare.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="680" Spacing="24">
            <TextBlock Text="偏好设置 (Settings)" FontSize="24" FontWeight="Bold" />

            <!-- AI Engine Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource AIAccentBrush}" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="AI 智能引擎设置" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>

                    <RadioButtons Header="AI 运行模式" SelectedIndex="0">
                        <RadioButton Content="端侧离线模型 (Google Gemma 3 / 100% 隐私无出网)" />
                        <RadioButton Content="云端大模型 API (DeepSeek / OpenAI / 本地 Ollama)" />
                    </RadioButtons>

                    <TextBox Header="API Base URL" Text="https://api.openai.com/v1" />
                    <PasswordBox Header="API Key" Password="sk-..." />
                    <TextBox Header="模型名称" Text="gpt-4o-mini" />

                    <Button Content="测试接口连通性" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Language & Appearance Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="语言与外观" FontWeight="SemiBold" FontSize="15" />

                    <ComboBox Header="显示语言 (Language)" SelectedIndex="0" MinWidth="180">
                        <ComboBoxItem Content="🇨🇳 简体中文" />
                        <ComboBoxItem Content="🇺🇸 English" />
                        <ComboBoxItem Content="🇯🇵 日本語" />
                    </ComboBox>

                    <ComboBox Header="主题外观 (Theme)" SelectedIndex="0" MinWidth="180">
                        <ComboBoxItem Content="跟随 Windows 系统" />
                        <ComboBoxItem Content="深色模式 (Dark)" />
                        <ComboBoxItem Content="浅色模式 (Light)" />
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
