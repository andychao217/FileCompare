<Page
    x:Class="WinCompare.UI.Views.TextDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar (Exact Mac layout from Image 2) -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group: Navigation & Options -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- 上一个差异 -->
                    <Button x:Name="PrevDiffBtn" Click="OnPrevDiffClicked" Padding="8,4" CornerRadius="4" Height="30">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74A;" FontSize="11" />
                            <TextBlock x:Name="PrevDiffText" Text="上一个差异" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 下一个差异 -->
                    <Button x:Name="NextDiffBtn" Click="OnNextDiffClicked" Padding="8,4" CornerRadius="4" Height="30">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74B;" FontSize="11" />
                            <TextBlock x:Name="NextDiffText" Text="下一个差异" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />

                    <!-- 忽略空白符 Switch -->
                    <Border x:Name="WhitespaceContainer" CornerRadius="4" Padding="6,2" Background="Transparent"
                            PointerPressed="OnWhitespaceContainerClicked" ToolTipService.ToolTip="比对时忽略空格和制表符差异">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="WhitespaceLabel" Text="忽略空白符" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ToggleSwitch x:Name="WhitespaceSwitch" OffContent="" OnContent="" Toggled="OnDiffOptionsChanged" />
                        </StackPanel>
                    </Border>

                    <!-- 忽略大小写 Switch -->
                    <Border x:Name="CaseContainer" CornerRadius="4" Padding="6,2" Background="Transparent" Margin="2,0,0,0"
                            PointerPressed="OnCaseContainerClicked" ToolTipService.ToolTip="比对时忽略字母大小写差异">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="CaseLabel" Text="忽略大小写" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ToggleSwitch x:Name="CaseSwitch" OffContent="" OnContent="" Toggled="OnDiffOptionsChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Group: Merge Actions, AI, Clear, Encoding -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- 采纳左侧 -->
                    <Button x:Name="TakeLeftBtn" Click="OnTakeLeftClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="采纳左侧内容至右侧">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE749;" FontSize="11" />
                            <TextBlock x:Name="TakeLeftText" Text="采纳左侧" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 采纳右侧 -->
                    <Button x:Name="TakeRightBtn" Click="OnTakeRightClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="采纳右侧内容至左侧">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE748;" FontSize="11" />
                            <TextBlock x:Name="TakeRightText" Text="采纳右侧" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />

                    <!-- AI 摘要 -->
                    <Button x:Name="AISummaryButton" Click="OnAISummaryClicked"
                            Background="{ThemeResource AIPurpleDarkBrush}" Foreground="{ThemeResource TextOnAccentBrush}" CornerRadius="6" Padding="10,4" Height="30" ToolTipService.ToolTip="智能分析改动意图">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="12" />
                            <TextBlock x:Name="AIBtnText" Text="AI 摘要" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 一键清空 -->
                    <Button x:Name="ClearAllBtn" Click="OnClearAllClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="一键清空对比内容与文件">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                            <TextBlock x:Name="ClearAllText" Text="一键清空" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />

                    <!-- 编码选择器 -->
                    <ComboBox x:Name="EncodingComboBox" Width="96" SelectionChanged="OnEncodingChanged" FontSize="11" Padding="8,4" Height="30" VerticalAlignment="Center">
                        <ComboBoxItem Content="UTF-8" />
                        <ComboBoxItem Content="GBK" />
                        <ComboBoxItem Content="UTF-16 LE" />
                        <ComboBoxItem Content="UTF-16 BE" />
                        <ComboBoxItem Content="ASCII" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Workspace Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Dual File Headers (Matching Mac Header Bar) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left File Header -->
                    <Grid Grid.Column="0" Padding="12,0" Background="Transparent" AllowDrop="True" DragOver="OnLeftDragOver" Drop="OnLeftDrop">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LeftHeader" Text="源文件 (左侧)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="LeftBrowseBtn" Content="选择..." FontSize="11" Padding="8,2" Click="OnPickLeftFileClicked" CornerRadius="4" Height="24" />
                            <Button x:Name="LeftSaveBtn" Content="保存" FontSize="11" Padding="8,2" Click="OnSaveLeftFileClicked" CornerRadius="4" Height="24" />
                        </StackPanel>
                    </Grid>

                    <!-- Center Divider -->
                    <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                    <!-- Right File Header -->
                    <Grid Grid.Column="2" Padding="12,0" Background="Transparent" AllowDrop="True" DragOver="OnRightDragOver" Drop="OnRightDrop">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="RightHeader" Text="目标文件 (右侧)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="RightBrowseBtn" Content="选择..." FontSize="11" Padding="8,2" Click="OnPickRightFileClicked" CornerRadius="4" Height="24" />
                            <Button x:Name="RightSaveBtn" Content="保存" FontSize="11" Padding="8,2" Click="OnSaveRightFileClicked" CornerRadius="4" Height="24" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Left Empty Drop Zone -->
            <Border x:Name="LeftDropZone" Grid.Row="1" Grid.Column="0" Background="Transparent" AllowDrop="True" DragOver="OnLeftDragOver" Drop="OnLeftDrop" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8F4;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LeftEmptyTitle" Text="未选择文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="LeftEmptyDesc" Text="拖拽文件至此处或点击下方按钮选择" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <Button x:Name="LeftPickBtn" Content="选择源文件..." Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="18,8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Click="OnPickLeftFileClicked" />
                </StackPanel>
            </Border>

            <!-- Left Single File View with Line Numbers -->
            <ListView x:Name="LeftSingleListView" Grid.Row="1" Grid.Column="0" SelectionMode="Single" Padding="0"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      AllowDrop="True" DragOver="OnLeftDragOver" Drop="OnLeftDrop"
                      Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Line Number Gutter -->
                            <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="0,0,8,0">
                                <TextBlock Text="{Binding LineNumText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <!-- Text Content -->
                            <TextBlock Grid.Column="1" Text="{Binding Content}" VerticalAlignment="Center" Padding="8,0,8,0"
                                       FontSize="12" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Center Divider for Empty / Single Mode -->
            <Rectangle x:Name="CenterDivider" Grid.Row="1" Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Right Empty Drop Zone -->
            <Border x:Name="RightDropZone" Grid.Row="1" Grid.Column="2" Background="Transparent" AllowDrop="True" DragOver="OnRightDragOver" Drop="OnRightDrop" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE8F4;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RightEmptyTitle" Text="未选择文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="RightEmptyDesc" Text="拖拽文件至此处或点击下方按钮选择" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <Button x:Name="RightPickBtn" Content="选择目标文件..." Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="18,8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Click="OnPickRightFileClicked" />
                </StackPanel>
            </Border>

            <!-- Right Single File View with Line Numbers -->
            <ListView x:Name="RightSingleListView" Grid.Row="1" Grid.Column="2" SelectionMode="Single" Padding="0"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      AllowDrop="True" DragOver="OnRightDragOver" Drop="OnRightDrop"
                      Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Line Number Gutter -->
                            <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="0,0,8,0">
                                <TextBlock Text="{Binding LineNumText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <!-- Text Content -->
                            <TextBlock Grid.Column="1" Text="{Binding Content}" VerticalAlignment="Center" Padding="8,0,8,0"
                                       FontSize="12" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Aligned Visual Dual Diff ListView (Visible when both files loaded) -->
            <Grid x:Name="DiffListContainer" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  AllowDrop="True" DragOver="OnDiffContainerDragOver" Drop="OnDiffContainerDrop">
                <ListView x:Name="DiffListView" SelectionMode="Single" Padding="0"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          AllowDrop="True" DragOver="OnDiffContainerDragOver" Drop="OnDiffContainerDrop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Diff Cell -->
                                <Grid Grid.Column="0" Background="{Binding LeftBgBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Line number + Sign gutter -->
                                    <Grid Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Change indicator -->
                                        <TextBlock Grid.Column="0" Text="{Binding LeftSign}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{Binding LeftFgBrush}" />
                                        <!-- Line number -->
                                        <TextBlock Grid.Column="1" Text="{Binding LeftLineNumText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <!-- Line text -->
                                    <TextBlock Grid.Column="1" Text="{Binding LeftText}" VerticalAlignment="Center" Padding="8,0,8,0"
                                               FontSize="12" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Center Divider -->
                                <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <!-- Right Diff Cell -->
                                <Grid Grid.Column="2" Background="{Binding RightBgBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Line number + Sign gutter -->
                                    <Grid Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Change indicator -->
                                        <TextBlock Grid.Column="0" Text="{Binding RightSign}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{Binding RightFgBrush}" />
                                        <!-- Line number -->
                                        <TextBlock Grid.Column="1" Text="{Binding RightLineNumText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="11" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                    <!-- Line text -->
                                    <TextBlock Grid.Column="1" Text="{Binding RightText}" VerticalAlignment="Center" Padding="8,0,8,0"
                                               FontSize="12" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Direct Editable Editors (Left & Right - fallback / direct edit) -->
            <TextBox x:Name="LeftEditor" Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource CodeFontFamily}" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" TextChanged="OnTextChanged" Visibility="Collapsed"
                     AllowDrop="True" DragOver="OnLeftDragOver" Drop="OnLeftDrop" />

            <!-- Left Loading Overlay -->
            <Grid x:Name="LeftLoadingOverlay" Grid.Row="1" Grid.Column="0" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="LeftLoadingText" Text="正在读取源文件..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="RightEditor" Grid.Row="1" Grid.Column="2" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="{StaticResource CodeFontFamily}" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" TextChanged="OnTextChanged" Visibility="Collapsed"
                     AllowDrop="True" DragOver="OnRightDragOver" Drop="OnRightDrop" />

            <!-- Right Loading Overlay -->
            <Grid x:Name="RightLoadingOverlay" Grid.Row="1" Grid.Column="2" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="RightLoadingText" Text="正在读取目标文件..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Dual Compare Loading Overlay -->
            <Grid x:Name="DualCompareLoadingOverlay" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Left Side Loading -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="DualLeftLoadingText" Text="正在读取源文件..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <!-- Center Divider -->
                <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                <!-- Right Side Loading -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock x:Name="DualRightLoadingText" Text="正在读取目标文件..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Floating AI Summary Card (Acrylic) -->
            <Border x:Name="AICard" Grid.Row="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,24,0" Width="480"
                    Background="{ThemeResource CardAcrylicBackground}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource AIAccentHoverBrush}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock x:Name="AICardTitle" Text="AI 改动意图总结" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AICardTextBrush}" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource AIAccentBgSubtleBrush}" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="AIModelBadge" Text="Gemma 3" FontSize="10" Foreground="{ThemeResource AIAccentBrush}" FontWeight="Medium" />
                            </Border>
                            <ProgressRing x:Name="AIProgressRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="OnCloseAICardClicked" Background="Transparent" BorderThickness="0" Padding="4" Height="26" Width="26">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- One-line Intent with lightbulb -->
                    <Border Background="{ThemeResource WarningSubtleBgBrush}" BorderBrush="{ThemeResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA80;" FontSize="13" Foreground="{ThemeResource StatusModTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock x:Name="AIOneLineIntent" Text="正在分析改动意图..." FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Key modifications bullet list -->
                    <ListView x:Name="AIKeyModsList" SelectionMode="None" MaxHeight="120">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                    <Ellipse Width="4" Height="4" Fill="{ThemeResource AIAccentBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Conventional Commit Box -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,6">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D7;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AICommitPrompt" Text="推荐 Conventional Commit:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="AICommitMessage" Text="chore(diff): update implementation" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource StatusAddTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons Toolbar (Matching Mac) -->
                    <Grid Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                            <!-- 复制 Commit -->
                            <Button x:Name="CopyCommitBtn" Click="OnCopyCommitClicked" Background="{ThemeResource AIAccentBrush}" Foreground="{ThemeResource TextOnAccentBrush}" CornerRadius="6" Padding="10,4" Height="28">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="CopyCommitIcon" Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock x:Name="AICopyCommitBtnText" Text="复制 Commit" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <!-- 复制文本 -->
                            <Button x:Name="CopyTextBtn" Click="OnCopyTextClicked" CornerRadius="6" Padding="10,4" Height="28">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="CopyTextIcon" Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock x:Name="AICopyTextBtnText" Text="复制文本" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 重新分析 -->
                        <Button x:Name="ReanalyzeBtn" Click="OnReanalyzeClicked" HorizontalAlignment="Right" CornerRadius="6" Padding="8,4" Height="28" Background="Transparent" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="AIReanalyzeText" Text="重新分析" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar (Matching Image 2) -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Status message on left -->
                <TextBlock x:Name="StatusMessageText" HorizontalAlignment="Left" Text="" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                <!-- Status metrics on right (Matching: Ln 1, Col 1      0 项      UTF-8) -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock x:Name="CursorInfoText" Text="Ln 1, Col 1" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <StackPanel x:Name="StatusStatsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="StatusModText" FontSize="11" Foreground="{ThemeResource StatusModTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusAddText" FontSize="11" Foreground="{ThemeResource StatusAddTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusDelText" FontSize="11" Foreground="{ThemeResource StatusDelTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatsText" Text="0 项" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="EncodingStatusText" Text="UTF-8" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
