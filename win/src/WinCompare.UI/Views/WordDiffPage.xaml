<Page
    x:Class="WinCompare.UI.Views.WordDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Dual Doc Cards Bar -->
            <RowDefinition Height="*" />    <!-- Main 3-Column Workspace -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar (Matching Mac Image 2) -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group: 4 Mode Tabs + Search Box -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Segmented Mode Buttons -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="ModeStructBtn" Click="OnModeStructClicked"
                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                    CornerRadius="4" Padding="12,4" Height="28" FontSize="11" FontWeight="SemiBold">
                                <TextBlock x:Name="ModeStructText" Text="结构化内容比对" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="ModeStyleBtn" Click="OnModeStyleClicked"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="4" Padding="12,4" Height="28" FontSize="11">
                                <TextBlock x:Name="ModeStyleText" Text="样式格式比对" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="ModeTableBtn" Click="OnModeTableClicked"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="4" Padding="12,4" Height="28" FontSize="11">
                                <TextBlock x:Name="ModeTableText" Text="表格网格比对" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="ModeMetaBtn" Click="OnModeMetaClicked"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="4" Padding="12,4" Height="28" FontSize="11">
                                <TextBlock x:Name="ModeMetaText" Text="文档元数据比对" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search Box -->
                    <AutoSuggestBox x:Name="WordSearchBox"
                                    PlaceholderText="搜索与过滤段落..." QueryIcon="Find"
                                    Width="220" Height="28" VerticalAlignment="Center"
                                    TextChanged="OnSearchTextChanged" FontSize="11" />
                </StackPanel>

                <!-- Right Group: Export Report, Clear All -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- 导出差异报告 -->
                    <Button x:Name="ExportReportBtn" Click="OnExportDiffClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="导出差异报告">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                            <TextBlock x:Name="ExportReportText" Text="导出差异报告" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 一键清空 -->
                    <Button x:Name="ClearAllBtn" Click="OnClearAllClicked" Padding="8,4" CornerRadius="4" Height="30" ToolTipService.ToolTip="一键清空对比内容与文档">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dual File Headers (Matching Mac Image 2 Dual Card Bars) -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderSidebarCol" Width="220" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar header placeholder -->
                <Grid Grid.Column="0" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8FD;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="文档章节大纲" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="OutlineCountBadge" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Click="OnToggleSidebarClicked" Background="Transparent" BorderThickness="0" Padding="4" Height="24" Width="24" ToolTipService.ToolTip="折叠大纲">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>

                <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                <!-- Left Source Doc Header Card -->
                <Grid Grid.Column="2" Padding="12,6" AllowDrop="True" DragOver="OnLeftDocDragOver" Drop="OnLeftDocDrop">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="#3B82F6" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LeftDocTitle" Text="选择源文件..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            <TextBlock x:Name="LeftDocSubtitle" Text="未选择文件" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="LeftBrowseBtn" HorizontalAlignment="Right" Content="选择..." FontSize="11" Padding="8,2" Click="OnPickLeftDocClicked" CornerRadius="4" Height="24" VerticalAlignment="Center" />
                </Grid>

                <Rectangle Grid.Column="3" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                <!-- Right Target Doc Header Card -->
                <Grid Grid.Column="4" Padding="12,6" AllowDrop="True" DragOver="OnRightDocDragOver" Drop="OnRightDocDrop">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" Foreground="#3B82F6" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="RightDocTitle" Text="选择目标文件..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            <TextBlock x:Name="RightDocSubtitle" Text="未选择文件" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="RightBrowseBtn" HorizontalAlignment="Right" Content="选择..." FontSize="11" Padding="8,2" Click="OnPickRightDocClicked" CornerRadius="4" Height="24" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Main Workspace Area (3 Columns matching Mac Image 2) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Document Outline Sidebar -->
            <Grid Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <!-- Outline Empty State -->
                <StackPanel x:Name="OutlineEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="16">
                    <FontIcon Glyph="&#xE8FD;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="OutlineEmptyTitle" Text="未检测到标题大纲" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OutlineEmptyDesc" Text="Word 标题样式 (H1~H6) 将自动在此提取为章节大纲" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- Active Outline TreeView -->
                <TreeView x:Name="OutlineTree" Visibility="Collapsed" ItemInvoked="OnOutlineItemInvoked" Padding="4" />
            </Grid>

            <!-- Vertical Divider -->
            <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

            <!-- Column 2 & 3: Dual Doc Viewport (Empty State vs Aligned View) -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Dual Drop Zones (Empty State matching Image 2) -->
                <Grid x:Name="EmptyStateContainer" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Empty Drop Zone (Source) -->
                    <Border Grid.Column="0" Background="Transparent" AllowDrop="True" DragOver="OnLeftDocDragOver" Drop="OnLeftDocDrop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE898;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LeftEmptyTitle" Text="未选择源文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="LeftEmptyDesc" Text="拖拽 .docx 或 .doc 文档至此处开始比对" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Button x:Name="LeftPickBtn" Content="选择源文件..." Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="18,8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Click="OnPickLeftDocClicked" />
                        </StackPanel>
                    </Border>

                    <!-- Center Divider -->
                    <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                    <!-- Right Empty Drop Zone (Target) -->
                    <Border Grid.Column="2" Background="Transparent" AllowDrop="True" DragOver="OnRightDocDragOver" Drop="OnRightDocDrop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE8F4;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="RightEmptyTitle" Text="未选择目标文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="RightEmptyDesc" Text="拖拽 .docx 或 .doc 文档至此处开始比对" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Button x:Name="RightPickBtn" Content="选择目标文件..." Style="{StaticResource AccentButtonStyle}" CornerRadius="6" Padding="18,8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Click="OnPickRightDocClicked" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Mode 1: Aligned Paragraphs List -->
                <ListView x:Name="ParagraphsList" Grid.Column="0" Grid.ColumnSpan="3" SelectionMode="Single" Padding="0" Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="36" Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Paragraph -->
                                    <Border Grid.Column="0" Background="{Binding LeftBgBrush}" Padding="12,6">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding LeftIndexText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource CodeFontFamily}" />
                                                <Border Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="4,1" Visibility="{Binding LeftBadgeVisibility}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LeftText}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                        </StackPanel>
                                    </Border>

                                    <Rectangle Grid.Column="1" Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

                                    <!-- Right Paragraph -->
                                    <Border Grid.Column="2" Background="{Binding RightBgBrush}" Padding="12,6">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding RightIndexText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="{StaticResource CodeFontFamily}" />
                                                <Border Background="{Binding StatusBgBrush}" CornerRadius="3" Padding="4,1" Visibility="{Binding RightBadgeVisibility}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding StatusFgBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RightText}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Mode 2: Table Diff View -->
                <ScrollViewer x:Name="TableDiffView" Grid.Column="0" Grid.ColumnSpan="3" Padding="16" Visibility="Collapsed">
                    <StackPanel x:Name="TableDiffContainer" Spacing="16" />
                </ScrollViewer>

                <!-- Mode 3: Metadata View -->
                <ScrollViewer x:Name="MetadataDiffView" Padding="20" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock x:Name="MetadataHeader" Text="文档属性与元数据对比" FontWeight="Bold" FontSize="14" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <TextBlock x:Name="MetadataDetailsText" Text="尚未载入文档" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status Bar -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12,4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Left: Sidebar toggle button and message -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="OnToggleSidebarClicked" Background="Transparent" BorderThickness="0" Padding="4" Height="24" Width="24" ToolTipService.ToolTip="展开/收起章节大纲">
                        <FontIcon Glyph="&#xE8A0;" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="StatusBarText" Text="未比对" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Status info -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="DiffBadge" Text="0 处差异" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="OpenXML DOM + Myers LCS Engine" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
