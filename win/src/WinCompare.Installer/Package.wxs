<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="WinCompare"
           Manufacturer="Andy Chao"
           Version="$(var.Version)"
           UpgradeCode="B9F7B612-4217-4886-A06F-8BE54D8C1234"
           Scope="perMachine"
           Language="1033">

    <SummaryInformation Description="WinCompare - Native WinUI 3 File Diff and Merge Tool"
                        Manufacturer="Andy Chao" />

    <!-- Allow same-version reinstall and prevent downgrade -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of WinCompare is already installed." />

    <!-- Embed all installation files into a single MSI CAB -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Application Icon in Windows Add/Remove Programs -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.SourceDir)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/andychao217/FileCompare" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andychao217/FileCompare" />

    <!-- Installation Directory Structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WinCompare" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="WinCompare" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Components -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Main GUI Executable -->
      <Component Id="MainExecutable" Guid="*">
        <File Id="WinCompareUIExe"
              Source="$(var.PublishDir)\WinCompare.UI.exe"
              KeyPath="yes" />
      </Component>

      <!-- Optional CLI Tool (wincmp) & PATH Environment Variable -->
      <Component Id="CliExecutable" Guid="*">
        <File Id="WinCmpExe"
              Source="$(var.PublishDir)\wincmp.exe"
              KeyPath="yes" />
        <!-- Append INSTALLFOLDER to system PATH so 'wincmp' is available anywhere in terminal -->
        <Environment Id="PATH"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>
    </DirectoryRef>

    <!-- Published Files Harvesting into a ComponentGroup -->
    <ComponentGroup Id="AppHarvestedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\WinCompare.UI.exe" />
        <Exclude Files="$(var.PublishDir)\wincmp.exe" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Start Menu & Desktop Shortcuts with HKCU KeyPath (Resolves ICE43 & ICE57) -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcuts" Guid="*">
        <!-- Start Menu Shortcut -->
        <Shortcut Id="StartMenuShortcut"
                  Name="WinCompare"
                  Description="WinUI 3 Native File Comparison and Merge Tool"
                  Target="[INSTALLFOLDER]WinCompare.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <!-- Desktop Shortcut -->
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="WinCompare"
                  Description="WinUI 3 Native File Comparison and Merge Tool"
                  Target="[INSTALLFOLDER]WinCompare.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <!-- CLI Start Menu Shortcut -->
        <Shortcut Id="CliStartMenuShortcut"
                  Name="WinCompare CLI (wincmp)"
                  Description="Terminal Git Diff and Merge Tool"
                  Target="[INSTALLFOLDER]wincmp.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanUpProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\WinCompare" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Installation Features -->
    <Feature Id="MainFeature" Title="WinCompare Application" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="CliExecutable" />
      <ComponentRef Id="ApplicationShortcuts" />
      <ComponentGroupRef Id="AppHarvestedFiles" />
    </Feature>

    <!-- Professional Wizard UI with Folder Selection & License Agreement -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
