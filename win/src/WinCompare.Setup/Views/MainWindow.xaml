<ui:FluentWindow x:Class="WinCompare.Setup.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:WinCompare.Setup.Models"
        mc:Ignorable="d"
        Title="{Binding Loc.WindowTitle}"
        Width="620" Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/AppIcon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar with Quick Language & Theme Pickers -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Loc.WindowTitle}"
                     Icon="pack://application:,,,/Assets/AppIcon.ico"
                     ShowMaximize="False"
                     ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Language Selection -->
                    <ComboBox SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Padding="6,2"
                              Margin="0,0,6,0"
                              FontSize="11"
                              Height="26"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="🌐 自动 (Auto)" Tag="{x:Static models:AppLanguage.Auto}" />
                        <ComboBoxItem Content="🇨🇳 简体中文" Tag="{x:Static models:AppLanguage.ZhHans}" />
                        <ComboBoxItem Content="🇺🇸 English" Tag="{x:Static models:AppLanguage.En}" />
                        <ComboBoxItem Content="🇯🇵 日本語" Tag="{x:Static models:AppLanguage.Ja}" />
                    </ComboBox>

                    <!-- Theme Selection (Moved to Header, Multi-language) -->
                    <ComboBox SelectedValue="{Binding SelectedThemeMode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Padding="6,2"
                              FontSize="11"
                              Height="26"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="{Binding Loc.SystemThemeOption}" Tag="System" />
                        <ComboBoxItem Content="{Binding Loc.LightThemeOption}" Tag="Light" />
                        <ComboBoxItem Content="{Binding Loc.DarkThemeOption}" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Surface: Centered with compact vertical flow -->
        <Grid Grid.Row="1" Margin="32,6,32,8" VerticalAlignment="Center">
            <!-- State: Ready (Initial State) -->
            <StackPanel HorizontalAlignment="Center" Width="480">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Ready}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Header Info: Logo + App Name + Tagline (Compact & Focused) -->
                <Image Source="pack://application:,,,/Assets/AppIcon.png" 
                       Width="56" Height="56" 
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="WinCompare" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,6,0,2"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding HeaderTaglineText}" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Primary Action Button: Uses System Accent Color with crisp White text -->
                <ui:Button Content="{Binding ActionButtonText}" 
                           Command="{Binding StartInstallCommand}"
                           Appearance="Primary"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Width="220" Height="38"
                           FontSize="15" FontWeight="SemiBold"
                           Margin="0,18,0,0"
                           Cursor="Hand" />

                <!-- Advanced Options Toggle Button with animated chevron -->
                <ui:HyperlinkButton Command="{Binding ToggleAdvancedCommand}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    FontSize="12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc.AdvancedOptions}" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="ChevronDown16" Margin="4,2,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform x:Name="ChevronRotate" Angle="0" />
                            </ui:SymbolIcon.RenderTransform>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="180" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="0" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </StackPanel>
                </ui:HyperlinkButton>

                <!-- Collapsible Advanced Options Panel (Super clean: only path & shortcuts) -->
                <Border CornerRadius="8" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="16,10"
                        Margin="0,10,0,0"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="MaxHeight" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                 To="110"
                                                                 Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                 To="0"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0"
                                                                 Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- Path Selection -->
                        <TextBlock Text="{Binding Loc.InstallDirectoryLabel}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,3,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" 
                                        Text="{Binding Options.InstallPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        VerticalAlignment="Center" 
                                        FontSize="12" />
                            <ui:Button Grid.Column="1" 
                                       Content="{Binding Loc.Browse}" 
                                       Command="{Binding BrowsePathCommand}" 
                                       Margin="8,0,0,0" 
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Checkboxes -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <CheckBox Content="{Binding Loc.DesktopShortcut}" 
                                      IsChecked="{Binding Options.CreateDesktopShortcut}" 
                                      FontSize="12" 
                                      Margin="0,0,16,0" />
                            <CheckBox Content="{Binding Loc.StartMenuShortcut}" 
                                      IsChecked="{Binding Options.CreateStartMenuShortcut}" 
                                      FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- State: Installing / Uninstalling (Progress State) -->
            <StackPanel HorizontalAlignment="Center" Width="440">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Installing}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Uninstalling}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Image Source="pack://application:,,,/Assets/AppIcon.png" 
                       Width="48" Height="48" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <ProgressBar Value="{Binding ProgressPercentage}" 
                             Height="8" 
                             HorizontalAlignment="Stretch" 
                             Margin="0,0,0,8" />

                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" 
                               HorizontalAlignment="Left" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding DetailedProgressText}" 
                               HorizontalAlignment="Right" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- State: Finished (Success State) -->
            <StackPanel HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Finished}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ui:SymbolIcon Symbol="CheckmarkCircle24" 
                               FontSize="48" 
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8" />
                <TextBlock Text="{Binding Loc.InstallSuccess}" 
                           FontSize="17" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           Margin="0,0,0,20" />

                <!-- Action Button Group: Launch Now + Close Window -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="{Binding Loc.LaunchNow}" 
                               Command="{Binding LaunchAppCommand}"
                               Appearance="Primary"
                               Foreground="White"
                               Width="150" Height="38"
                               FontSize="14" FontWeight="SemiBold"
                               Cursor="Hand" />

                    <ui:Button Content="{Binding Loc.Close}" 
                               Command="{Binding CloseWindowCommand}"
                               Width="120" Height="38"
                               FontSize="14"
                               Margin="12,0,0,0"
                               Cursor="Hand" />
                </StackPanel>
            </StackPanel>

            <!-- State: UninstallFinished -->
            <StackPanel HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.UninstallFinished}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ui:SymbolIcon Symbol="CheckmarkCircle24" 
                               FontSize="48" 
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8" />
                <TextBlock Text="{Binding Loc.UninstallSuccess}" 
                           FontSize="17" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           Margin="0,0,0,16" />

                <ui:Button Content="{Binding Loc.Finish}" 
                           Command="{Binding CloseWindowCommand}"
                           HorizontalAlignment="Center"
                           Width="160" Height="36" />
            </StackPanel>

            <!-- State: Error State -->
            <StackPanel HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ui:SymbolIcon Symbol="DismissCircle24" 
                               FontSize="48" 
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8" />
                <TextBlock Text="{Binding Loc.OperationFailed}" 
                           FontSize="15" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding ErrorMessage}" 
                           TextWrapping="Wrap" 
                           MaxWidth="400"
                           HorizontalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           FontSize="12" 
                           Margin="0,0,0,14" />

                <ui:Button Content="{Binding Loc.Exit}" 
                           Command="{Binding CloseWindowCommand}"
                           HorizontalAlignment="Center"
                           Width="140" Height="36" />
            </StackPanel>
        </Grid>

        <!-- Bottom Note: Only shown in Ready state -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding Loc.LicenseNotice}" 
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Ready}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</ui:FluentWindow>
